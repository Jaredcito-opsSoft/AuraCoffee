PORT=3001
NODE_ENV=development

# Supabase (obtener en dashboard.supabase.com → Project Settings → API)
DATABASE_URL="postgresql://postgres:[TU-PASSWORD]@db.[TU-PROJECT-ID].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[TU-PASSWORD]@db.[TU-PROJECT-ID].supabase.co:5432/postgres"
SUPABASE_URL="https://[TU-PROJECT-ID].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# JWT (mínimo 32 caracteres, generar con: openssl rand -base64 32)
JWT_SECRET="[GENERA-UN-SECRET-SEGURO-AQUI]"
JWT_EXPIRES_IN="8h"

# ============================================================
# FRONTEND (apps/web) — Solo variables públicas con VITE_
# ============================================================
VITE_SUPABASE_URL="https://[TU-PROJECT-ID].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."
VITE_API_URL="http://localhost:3001"
